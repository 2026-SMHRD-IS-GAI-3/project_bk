<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE configuration
  PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-config.dtd">

<configuration>

    <!-- DB 접속 정보가 들어있는 properties 파일 연결 -->
    <properties resource="com/kendo/database/db.properties"/>

    <!-- DTO 클래스 이름을 짧게 쓰기 위한 별칭 설정 -->
    <typeAliases>
        <typeAlias type="com.kendo.model.UserDTO" alias="UserDTO"/>
    </typeAliases>

    <!-- DB 연결 환경 설정 -->
    <environments default="development">
        <environment id="development">

            <!-- JDBC 트랜잭션 사용 -->
            <transactionManager type="JDBC"/>

            <!-- DB 커넥션 풀 사용 -->
            <dataSource type="POOLED">
                <property name="driver" value="${driver}"/>
                <property name="url" value="${url}"/>
                <property name="username" value="${username}"/>
                <property name="password" value="${password}"/>
            </dataSource>

        </environment>
    </environments>

    <!-- SQL이 작성된 Mapper XML 연결 -->
    <mappers>
        <mapper resource="com/kendo/database/UserMapper.xml"/>
    </mappers>

</configuration>
