<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
  PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-config.dtd">
 
<!-- configuration : mybatis 설정을 기술하는 태그 -->
<configuration>

<properties resource="com/kendo/database/db.properties"></properties>
	
	<typeAliases>
    <typeAlias type="com.kendo.model.UserDTO" alias="UserDTO"/>

    <!-- 훈련 자세 이미지/영상 정보를 담는 DTO -->
    <typeAlias type="com.kendo.model.TrainingDTO" alias="TrainingDTO"/>
</typeAliases>
	
  <environments default="development">
    <environment id="development">
      <transactionManager type="JDBC"/>
      <dataSource type="POOLED">
        <property name="driver" value="${driver}"/>
        <property name="url" value="${url}"/>
        <property name="username" value="${username}"/>
        <property name="password" value="${password}"/>
      </dataSource>
    </environment>
  </environments>
  
  <!-- 사용자가 수행할 sql문장을 파일로 연결하여 관리하는 태그 -->
 
	<mappers>
  		<mapper resource="com/kendo/database/UserMapper.xml"/>
	</mappers>
	
	
	
	
	
</configuration>